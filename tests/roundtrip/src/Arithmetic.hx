class Arithmetic {
    public static function main() {
        var a = 10;
        var b = 3;
        var sum = a + b;
        var diff = a - b;
        var prod = a * b;
        var quot = a / b;
        var mod = a % b;
        Sys.println("sum=" + sum);
        Sys.println("diff=" + diff);
        Sys.println("prod=" + prod);
        Sys.println("quot=" + quot);
        Sys.println("mod=" + mod);
    }
}
