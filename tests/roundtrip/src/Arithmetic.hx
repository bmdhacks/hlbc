class Arithmetic {
    public static function main() {
        var a = 10;
        var b = 3;
        var sum = a + b;
        var diff = a - b;
        var prod = a * b;
        var quot = a / b;
        var mod = a % b;
        trace("sum=" + sum);
        trace("diff=" + diff);
        trace("prod=" + prod);
        trace("quot=" + quot);
        trace("mod=" + mod);
    }
}
